[Unit]
Description=Start the local Claudex gateway and Codex backend

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=CODEX_HOME=%h/.codex
ExecStart=%h/.local/bin/codex app-server daemon start
ExecStart=%h/.local/bin/claudex start
ExecStop=%h/.local/bin/claudex stop
KillMode=process
TimeoutStartSec=60
TimeoutStopSec=15

[Install]
WantedBy=default.target
